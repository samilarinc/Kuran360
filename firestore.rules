rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // User data and profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow public to see basic profile info (only displayName)
      match /profile/public {
        allow read: if true;
      }
      
      // Allow anyone (even non-logged in) to create a dua request
      match /duaRequests/{requestId} {
        allow create: if true;
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }


      // Allow access to other subcollections (data, meta, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }


    // Forum threads
    match /threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Allow updating replyCount and updatedAt
    }

    // Forum posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Hatims
    match /hatims/{hatimId} {
      allow read: if resource.data.get('isPrivate', false) == false || (isSignedIn() && (
        resource.data.creatorId == request.auth.uid || 
        request.auth.uid == 'REMOVED_ADMIN_UID' // Admin ID
      ));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        !resource.data.isLocked || 
        resource.data.creatorId == request.auth.uid || 
        request.auth.uid == 'REMOVED_ADMIN_UID'
      ); 
      allow delete: if isSignedIn() && (
          resource.data.creatorId == request.auth.uid || 
          request.auth.uid == 'REMOVED_ADMIN_UID'
      );
    }
  }
}
