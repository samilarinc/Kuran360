<?xml version="1.0" encoding="utf-8"?>
<!-- Combined widget: the times on top, a verse below (see widget_times_part and widget_verse_part) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

  <include
      layout="@layout/widget_times_part"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="2" />

  <!-- Divider; a FrameLayout since plain Views aren't allowed in widgets -->
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:background="#33FFFFFF" />

  <include
      layout="@layout/widget_verse_part"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="3" />
</LinearLayout>
