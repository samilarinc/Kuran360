<?xml version="1.0" encoding="utf-8"?>
<!--
  Countdown widget: the next prayer's name and the countdown to it (filled in PrayerWidgets.countdownViews).
  Rows share the height by weight and auto-size their text, so the text grows with the widget (1x1, 1x2, 2x2...).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

  <TextView
      android:id="@+id/widget_label"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="2"
      android:autoSizeMaxTextSize="20sp"
      android:autoSizeMinTextSize="9sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:maxLines="1"
      android:text="@string/widget_preview_prayer"
      android:textColor="#CCFFFFFF"
      android:textSize="13sp"
      android:textStyle="bold" />

  <Chronometer
      android:id="@+id/widget_countdown"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="3"
      android:autoSizeMaxTextSize="40sp"
      android:autoSizeMinTextSize="10sp"
      android:autoSizeTextType="uniform"
      android:fontFeatureSettings="tnum"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />

  <!-- Until the app has sent the times -->
  <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:autoSizeMaxTextSize="16sp"
      android:autoSizeMinTextSize="9sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:maxLines="3"
      android:text="@string/widget_no_data"
      android:textColor="#FFFFFF"
      android:textSize="11sp"
      android:visibility="gone" />
</LinearLayout>
